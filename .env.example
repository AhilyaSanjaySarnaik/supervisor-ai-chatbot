# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- MCP / GitHub integration ---
# mock = simulate all tool calls locally, no network/token needed (default, good for demos)
# live = speak the real MCP protocol to an actual GitHub MCP server
MCP_MODE=mock

# Only used when MCP_MODE=live.
# http  = GitHub's hosted server (api.githubcopilot.com) — no local server to run
# stdio = a local `github-mcp-server` process, typically via Docker
GITHUB_MCP_TRANSPORT=http
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_PERSONAL_ACCESS_TOKEN=

# Fallback owner/repo used when your chat message doesn't specify one
# (e.g. mention "octocat/Hello-World" in your message to override per-request)
GITHUB_DEFAULT_OWNER=octocat
GITHUB_DEFAULT_REPO=Hello-World

# --- Security tuning ---
# Comma-separated list of tool names that always require human approval, regardless of role
HIGH_RISK_TOOLS=create_pull_request,merge_pull_request,delete_repo,push_to_main,create_release

# How long (seconds) a pending HITL approval stays valid before auto-expiring
HITL_TIMEOUT_SECONDS=900
